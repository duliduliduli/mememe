MIGRATION_ADDRESS=replace_with_verified_current_address

# No RPC variables are required: PublicNode mainnet + Solana public mainnet are built in.
# Shared public endpoints can throttle; dedicated providers remain preferable for sustained use.
# Any standard Solana RPC works. RPC_URLS enables automatic failover in listed order.
# Use provider-issued HTTPS endpoints; do not commit their embedded API keys.
# RPC_URL=https://your-solana-rpc.example
# RPC_URLS=https://primary.example/key,https://backup.example/key
# WebSocket URLs are derived from HTTP(S) URLs. Set these only if the provider uses a
# different WebSocket endpoint. Keep the ordering aligned with RPC_URLS.
# RPC_WS_URL=wss://your-solana-rpc.example
# RPC_WS_URLS=wss://primary.example/key,wss://backup.example/key

# Optional historical collector / TRANSACTION_HISTORY_MODE=helius compatibility only.
# This key no longer selects the executor's default RPC provider.
# HELIUS_API_KEY=

# Optional: GeckoTerminal keyless API is used by default.
# Raise this only if your API plan permits it.
GECKO_REQUESTS_PER_MINUTE=9

# Dashboard job/executor control API password (invent a long random string)
ADMIN_TOKEN=replace_me
# Optional separate password for GET /logs. If blank/unset, ADMIN_TOKEN is used.
# Sign in with username "admin" and this password. Never put it in the URL.
LOG_VIEWER_TOKEN=
# Maximum tail of executor.log read by the phone log viewer (12 MB default).
LOG_VIEWER_MAX_BYTES=12000000

# --- Executor (live/paper trading) ---
# paper = real detection + real quotes, simulated fills, no wallet needed.
# live  = signs real transactions; requires WALLET_PRIVATE_KEY below.
EXECUTOR_MODE=paper
# Start the executor automatically when the dashboard container boots
EXECUTOR_AUTOSTART=0
# BURNER WALLET ONLY. Export a single account's private key from Phantom
# (never your seed phrase, never your main wallet). Fund it with only what
# you can afford to lose.
# WALLET_PRIVATE_KEY=
ACCOUNT_FRACTION=0.05
MAX_POSITION_USD=100
MIN_POSITION_USD=2
MAX_CONCURRENT_POSITIONS=5
DAILY_LOSS_LIMIT_USD=30

# Entry guards (2026-09-05 defaults). Ceiling off; impact 10% (a $5 order at 5% is $0.25).
MAX_PRICE_IMPACT_PCT=10
MAX_ENTRY_MARKET_CAP_USD=0
MIN_ENTRY_MARKET_CAP_USD=25000
MIN_CURVE_AGE_SECONDS=120
MIN_CURVE_TRANSACTIONS=150
MAX_TOP_HOLDER_PCT=20
MAX_CREATOR_HOLD_PCT=5
MAX_CREATOR_PRIOR_LAUNCHES=3
MAX_EARLY_SELL_PCT=3
# Pump.fun BOOST buy-and-burn window after migration; tagged on every trade and skip, not a guard.
BOOST_WINDOW_SECONDS=300

# Split-wallet / bundle signals. Percentages accept either 30 or legacy 0.30.
# Enforcement is on by default: risky launches and incomplete mandatory data are skipped.
MAX_BUNDLE_SLOT_PCT=30
MAX_CLUSTER_PCT=30
MAX_ANCESTRY_CLUSTER_PCT=20
MAX_TRANSFER_CLUSTER_PCT=12
MAX_COORDINATED_BUY_PCT=20
MAX_REPEAT_COHORT_PCT=12
MAX_DEV_CLUSTER_PCT=15
MAX_TOP10_WALLET_PCT=50
MAX_EARLY_BUY_PCT=30
MIN_FUNDER_COVERAGE_PCT=30
MIN_FUNDER_LOOKUP_PCT=30
HIGH_CONFIDENCE_FUNDER_COVERAGE_PCT=60
# Between the two coverage thresholds, every bundle limit is multiplied by this value.
PARTIAL_COVERAGE_LIMIT_MULTIPLIER=0.67
COORDINATED_WINDOW_SLOTS=12
COORDINATED_MIN_WALLETS=3
BUNDLE_LOG_ONLY=0
BUNDLE_FAIL_CLOSED=1
BUNDLE_LOOKUP_TIMEOUT_MS=1500
BUNDLE_LOOKUP_WORKERS=6
BUNDLE_MAX_WALLETS=50
# Trace funding ancestry only for the largest holders; all 50 still feed other graph checks.
BUNDLE_FUNDER_MAX_WALLETS=20
WALLET_GRAPH_CACHE_DAYS=30
# Immediate executable sell value divided by the proposed buy input.
MIN_ENTRY_ROUND_TRIP_PCT=80
# Provider-independent discovery/history. WebSocket hints are backed by a periodic
# getSignaturesForAddress catch-up so reconnects do not silently lose graduations.
DISCOVERY_MODE=websocket
DISCOVERY_CATCHUP_SECONDS=30
DISCOVERY_POLL_LIMIT=10
DISCOVERY_TIMEOUT_SECONDS=5
RPC_TIMEOUT_SECONDS=8
RPC_BATCH_SIZE=20
RPC_BACKOFF_MAX_SECONDS=900
TRANSACTION_HISTORY_MODE=raw
RAW_HISTORY_SIGNATURE_LIMIT=40
RAW_FUNDER_SIGNATURE_LIMIT=10
# Enable only on providers that implement Metaplex DAS getTokenAccounts. Standard RPC's
# portable top-20 holder path remains active when this is off.
RPC_DAS_ENABLED=0
# DAS_MINT_PARAM=mint
MAX_ENTRIES_PER_CYCLE=1
CATCHUP_POLL_LIMIT=50
MAX_ENTRIES_PER_MINUTE=0

# ---- Market-making research track (python -m mm ...; never trades) ----
# Universe: established tokens only. Ages in days, dollars are USD.
MM_BANKROLL_USD=87
MM_MAX_POSITION_USD=40
MM_MAX_TOKEN_EXPOSURE_USD=40
MM_MAX_PORTFOLIO_EXPOSURE_USD=80
MM_DAILY_LOSS_LIMIT_USD=10
MM_MIN_TOKEN_AGE_DAYS=30
MM_MIN_POOL_LIQUIDITY_USD=100000
MM_MIN_TRADERS_24H=300
MM_MIN_ORGANIC_SCORE=40
MM_MAX_TOP_HOLDERS_PCT=50
# Exit tests on executable Jupiter quotes: routine band for the full max inventory,
# emergency band must hold MM_EXIT_DEPTH_MULTIPLE x the max position.
MM_ROUTINE_EXIT_IMPACT_PCT=0.25
MM_EMERGENCY_EXIT_IMPACT_PCT=3
MM_EXIT_DEPTH_MULTIPLE=20
# Range = +/- MM_RANGE_WIDTH_SIGMA * hourly sigma * sqrt(MM_HORIZON_HOURS), clamped.
MM_HORIZON_HOURS=6
# Every N minutes the live candidate logs why it holds nothing (best edge and its terms).
MM_WHY_OUT_INTERVAL_MINUTES=15
MM_RANGE_WIDTH_SIGMA=2
MM_MIN_RANGE_HALF_WIDTH_PCT=3
MM_MAX_RANGE_HALF_WIDTH_PCT=25
MM_POLL_SECONDS=60
MM_UNIVERSE_REFRESH_MINUTES=60
# Lane control. MM_AUTOSTART=1 makes server.py launch `python -m mm $MM_MODE` next to the
# executor. MM_MODE=live trades adaptive_dlmm and momentum for real with WALLET_PRIVATE_KEY:
# Jupiter swaps from Python, Meteora DLMM positions through the Node sidecar (mm/sidecar).
# MM_BANKROLL_USD caps what this lane may deploy; the executor keeps trading the remainder.
MM_AUTOSTART=0
MM_MODE=paper
MM_LIVE_SLIPPAGE_BPS=100
# Each DLMM position locks ~0.057 SOL of refundable rent; this much SOL stays free per open.
MM_LP_POSITION_RENT_SOL=0.06
# Sidecar: spawned automatically on this port; set MM_SIDECAR_URL to use an external one.
MM_SIDECAR_PORT=8787
# MM_SIDECAR_URL=http://127.0.0.1:8787
# Sidecar RPC (falls back to RPC_URLS/RPC_URL). Position discovery needs getProgramAccounts,
# which PublicNode refuses; the standard mainnet endpoint or a paid provider works.
# MM_RPC_URLS=https://api.mainnet-beta.solana.com

# ---- EVM copy lane (Robinhood Chain, Base, BNB Chain) -----------------------
# Followed 0x addresses; empty = lane off. Same sizing/copy/exit variables as the Solana lane.
EVM_COPY_WALLETS=
# Burner EVM wallet: hex private key or 12/24-word phrase. Fund it with ETH on Robinhood Chain
# and Base, BNB on BNB Chain. Never reuse the Solana key.
EVM_PRIVATE_KEY=
# EVM_CHAINS=robinhood,base,bnb
# Uniswap Trading API key (developers.uniswap.org/dashboard): needed for Robinhood Chain V4 pools.
UNISWAP_API_KEY=
